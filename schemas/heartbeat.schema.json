{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://struggletime.dev/schemas/heartbeat-v1.json",
  "title": "RollupBucket v1 (wire protocol)",
  "description": "Mirror of src/verify.py ALLOWED_* — regenerate with scripts/sync_formula_docs.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["v","bucket_id","install_id","project_id","bucket_start_wall","bucket_secs","mono_delta_ms","counts","git","formula_version","prev_hash","hash"],
  "properties": {
    "v": {"const": 1},
    "bucket_id": {"type": "string"},
    "install_id": {"type": "string", "description": "inst_<sha256(pubkey)[:16]> when Ed25519 keys exist"},
    "project_id": {"type": "string"},
    "repo_remote_hash": {"type": ["string","null"]},
    "bucket_start_wall": {"type": "integer"},
    "bucket_secs": {"type": "integer", "minimum": 1},
    "mono_delta_ms": {"type": "integer", "minimum": 0},
    "counts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "human_edits": {"type": "integer", "minimum": 0},
        "ai_writes": {"type": "integer", "minimum": 0},
        "prompts": {"type": "integer", "minimum": 0},
        "executions": {"type": "integer", "minimum": 0},
        "exec_failures": {"type": "integer", "minimum": 0},
        "commits": {"type": "integer", "minimum": 0},
        "dwell_diff_secs": {"type": "integer", "minimum": 0},
        "idle_secs": {"type": "integer", "minimum": 0},
        "active_secs": {"type": "integer", "minimum": 0},
        "first_event_ts": {"type": "integer"},
        "last_event_ts": {"type": "integer"},
        "same_file_reedit_count": {"type": "integer", "minimum": 0},
        "ai_retry_loops": {"type": "integer", "minimum": 0},
        "failed_exec_count": {"type": "integer", "minimum": 0},
        "test_fail_to_pass_transitions": {"type": "integer", "minimum": 0},
        "agent_turn_churn": {"type": "integer", "minimum": 0},
        "human_recovery_edits": {"type": "integer", "minimum": 0},
        "atomic_agent_writes": {"type": "integer", "minimum": 0},
        "git_plumbing_pulses": {"type": "integer", "minimum": 0},
        "reflog_reverts": {"type": "integer", "minimum": 0},
        "build_test_cycles": {"type": "integer", "minimum": 0},
        "cache_fail_to_pass": {"type": "integer", "minimum": 0}
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "head_commit": {"type": ["string","null"]},
        "lines_added": {"type": "integer", "minimum": 0},
        "lines_deleted": {"type": "integer", "minimum": 0},
        "dirty_files": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array", "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "file_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
          "added": {"type": "integer", "minimum": 0},
          "deleted": {"type": "integer", "minimum": 0},
          "bursts": {"type": "integer", "minimum": 0},
          "op": {"enum": ["created","modified","deleted"]},
          "editor": {"type": "string", "maxLength": 32},
          "agent": {"type": "string", "maxLength": 32},
          "source": {"enum": ["layer1","adapter"]},
          "language": {"type": "string", "maxLength": 32}
        }
      }
    },
    "exec_categories": {"type": "object"},
    "editors": {"type": "object"},
    "agents": {"type": "object"},
    "languages": {"type": "object"},
    "os": {"type": "string", "maxLength": 32},
    "os_detail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "release": {"type": "string"},
        "arch": {"type": "string"}
      }
    },
    "formula_version": {"type": "string"},
    "prev_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA256(canonical_json(bucket without hash/signature) || prev_hash)"},
    "signature": {"type": ["string","null"], "description": "base64 Ed25519 signature over UTF-8 hash hex"},
    "install_pubkey": {"type": ["string","null"], "description": "base64 raw 32-byte Ed25519 public key"},
    "sig_alg": {"type": ["string","null"], "const": "ed25519"}
  }
}
