# copy to .env and fill in (cp .env.example .env) - .env is gitignored, never commit it
# server
PORT=18765
SERVER_DB=server.db

# github (all optional)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# oauth apps (create at github > settings > developer settings > oauth apps,
# and api.slack.com/apps > oauth & permissions; both redirect to /v1/auth/<provider>/callback)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Stable HTTPS public URL (Caddy + your domain). Slack requires https.
# Do NOT use ephemeral cloudflared quick tunnels — the URL changes every restart.
OAUTH_REDIRECT_BASE=https://struggletime.screenseekr.com
BIND=127.0.0.1

# slack (both optional)
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# daemon — same stable HTTPS origin as OAUTH_REDIRECT_BASE
AITIME_SERVER=https://struggletime.screenseekr.com
STRUGGLETIME_SERVER=https://struggletime.screenseekr.com
AITIME_USER=
AITIME_EXEC_LOG=~/.aitime/exec.jsonl
AITIME_BUCKET_SECS=300
AITIME_INSTALL=local

# openclaw adapter (optional)
OPENCLAW_SESSIONS=~/.openclaw/agents/main/sessions
