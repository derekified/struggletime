# copy to .env and fill in (cp .env.example .env) - .env is gitignored, never commit it
# server
PORT=18765
SERVER_DB=server.db

# github (all optional)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# oauth apps (create at github > settings > developer settings > oauth apps,
# and api.slack.com/apps > oauth & permissions; both redirect to /v1/auth/<provider>/callback)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# public address of this server. must match the callback urls registered in the
# oauth apps exactly, e.g. https://<you>.ngrok-free.app when tunnelling local
# when using a tunnel, set this to the https URL (also used for Slack/GitHub start)
OAUTH_REDIRECT_BASE=https://paper-identifier-specialist-sold.trycloudflare.com

# slack (both optional)
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# daemon (prefer the same public URL as OAUTH_REDIRECT_BASE when tunnelling)
AITIME_SERVER=https://paper-identifier-specialist-sold.trycloudflare.com
STRUGGLETIME_SERVER=https://paper-identifier-specialist-sold.trycloudflare.com
AITIME_USER=
AITIME_EXEC_LOG=~/.aitime/exec.jsonl
AITIME_BUCKET_SECS=300
AITIME_INSTALL=local

# openclaw adapter (optional)
OPENCLAW_SESSIONS=~/.openclaw/agents/main/sessions
