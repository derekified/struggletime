{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StruggleTime Dashboard",
  "version": "0.1.0",
  "identifier": "com.struggletime.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": ["settings"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../daemon/assets/struggletime-256.png",
      "../../daemon/assets/AppIcon.icns",
      "../../daemon/assets/struggletime.ico"
    ],
    "externalBin": ["binaries/struggletime"]
  }
}
