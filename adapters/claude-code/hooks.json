{
  "$schema": "struggletime-adapter/v1",
  "description": "Claude Code enrichment: prompt/agent-turn counts only. Merge into .claude/settings.json hooks; each command appends one category line the daemon already understands.",
  "hooks": {
    "PostToolUse": [{"matcher": "", "hooks": [{"type": "command", "command": "printf '{\"ts\":%s,\"category\":\"ai_cli\",\"verb\":\"tool\",\"exit_code\":0}\n' \"$(date +%s)\" >> \"${AITIME_EXEC_LOG:-$HOME/.aitime/exec.jsonl}\" "}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "printf '{\"ts\":%s,\"category\":\"ai_cli\",\"verb\":\"stop\",\"exit_code\":0}\n' \"$(date +%s)\" >> \"${AITIME_EXEC_LOG:-$HOME/.aitime/exec.jsonl}\" "}]}]
  }
}
